# Private inbox for support form submissions (never shown on the site)
SUPPORT_INBOX=you@example.com

# Recommended: Resend (https://resend.com) — no Gmail App Password needed
# Sign up with the same Gmail you use for SUPPORT_INBOX; free tier can deliver to that inbox.
RESEND_API_KEY=re_xxxxxxxx
# Optional; default uses Resend test sender:
# RESEND_FROM="Nova Blaster Support <onboarding@resend.dev>"

# Optional fallback: Gmail SMTP (requires App Password — often hidden in Google Account UI)
# Direct link to try: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
